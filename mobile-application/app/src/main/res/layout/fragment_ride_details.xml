<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:id="@+id/ride_details_view"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:text="@string/ride_details"
            style="@style/TextHeading"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp">

            <org.osmdroid.views.MapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginVertical="8dp"
            android:background="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvRoute"
            style="@style/TextSubHeading"/>
        <TextView
            android:id="@+id/tvStartedAt"
            style="@style/TextParagraph"/>
        <TextView
            android:id="@+id/tvEndedAt"
            style="@style/TextParagraph"/>
        <TextView
            android:id="@+id/tvPrice"
            style="@style/TextParagraph"/>
        <TextView
            android:id="@+id/tvPanic"
            style="@style/TextParagraph"/>
        <TextView
            android:id="@+id/tvCanceledBy"
            style="@style/TextParagraph"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginVertical="8dp"
            android:background="?attr/colorPrimary" />

        <TextView
            android:text="@string/passengers"
            style="@style/TextSubHeading"/>
        <TextView
            android:id="@+id/tvPassengers"
            style="@style/TextParagraph"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginVertical="8dp"
            android:background="?attr/colorPrimary" />

        <TextView
            android:text="@string/irregularity_reports"
            style="@style/TextSubHeading"/>
        <TextView
            android:id="@+id/tvReports"
            style="@style/TextParagraph"/>

    </LinearLayout>
</ScrollView>