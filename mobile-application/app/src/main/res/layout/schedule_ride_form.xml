<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Schedule a ride Section Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="schedule a ride"
        android:textSize="14sp"
        android:textColor="@color/gray_darker"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Starting Point -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/starting_point_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Starting Point"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/gray"
        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp"
        android:layout_marginBottom="12dp">

        <AutoCompleteTextView
            android:id="@+id/starting_point_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="text"
            android:completionThreshold="3"
            android:textSize="16sp"
            android:padding="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Add Stop Button -->
    <Button
        android:id="@+id/btn_add_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ add stop"
        android:textColor="@color/green"
        android:backgroundTint="@android:color/transparent"
        android:textAllCaps="false"
        android:layout_marginBottom="12dp"
        style="?attr/materialButtonOutlinedStyle"
        app:strokeColor="@color/green" />

    <!-- Stops Container -->
    <LinearLayout
        android:id="@+id/stops_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Destination -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/destination_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Destination"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/gray"
        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp"
        android:layout_marginBottom="12dp">

        <AutoCompleteTextView
            android:id="@+id/destination_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="text"
            android:completionThreshold="3"
            android:textSize="16sp"
            android:padding="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Add Passenger Button -->
    <Button
        android:id="@+id/btn_add_passenger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ add passenger"
        android:textColor="@color/green"
        android:backgroundTint="@android:color/transparent"
        android:textAllCaps="false"
        android:layout_marginBottom="12dp"
        style="?attr/materialButtonOutlinedStyle"
        app:strokeColor="@color/green" />

    <!-- Passengers Container -->
    <LinearLayout
        android:id="@+id/passengers_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Additional Instructions -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Additional instructions..."
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/gray"
        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp"
        android:layout_marginBottom="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/additional_instructions_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:textSize="16sp"
            android:padding="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Ride Preferences Section Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ride preferences"
        android:textSize="14sp"
        android:textColor="@color/gray_darker"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Vehicle Type Spinner -->
    <Spinner
        android:id="@+id/vehicle_type_spinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/gray"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Must Allow Pets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="must allow pets:"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_pets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/white"
            app:trackTint="@color/green" />
    </LinearLayout>

    <!-- Must Allow Babies -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="must allow babies:"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_babies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/white"
            app:trackTint="@color/green" />
    </LinearLayout>

    <!-- Schedule Type Spinner -->
    <Spinner
        android:id="@+id/schedule_type_spinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/gray"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Time Picker Container (visible when "schedule for later" is selected) -->
    <LinearLayout
        android:id="@+id/time_picker_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <NumberPicker
            android:id="@+id/hour_picker"
            android:layout_width="wrap_content"
            android:layout_height="150dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="8dp" />

        <NumberPicker
            android:id="@+id/minute_picker"
            android:layout_width="wrap_content"
            android:layout_height="150dp" />
    </LinearLayout>

    <!-- Estimated Price -->
    <LinearLayout
        android:id="@+id/price_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@color/gray"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estimated Price:"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/estimated_price_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calculating..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black" />
    </LinearLayout>

</LinearLayout>
